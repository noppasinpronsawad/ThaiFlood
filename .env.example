# ==============================================================================
# ThaiFlood Environment Variables Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก API Key / Token ที่ได้รับจากหน่วยงาน
# หมายเหตุ: ในโหมดทดสอบ (UAT) ปัจจุบัน ระบบสามารถทำงานได้โดยไม่ต้องกรอกค่าใดๆ
# ==============================================================================

# 1. กรมอุตุนิยมวิทยา (TMD NWP Weather Forecast API)
# ขอรับได้ที่: https://data.tmd.go.th/api/index1.php (TMD NWP API)
VITE_TMD_API_KEY=

# 2. คลังข้อมูลน้ำแห่งชาติ สสน. (ThaiWater API v3 / Data.go.th) - สำหรับระดับน้ำสถานีโทรมาตร
# ขอรับได้ที่: https://api.thaiwater.net หรือ https://data.go.th
VITE_THAIWATER_API_KEY=

# 3. GISTDA - สำหรับข้อมูลภาพถ่ายดาวเทียมขอบเขตน้ำท่วมสด
# ขอรับได้ที่: https://flood.gistda.or.th
VITE_GISTDA_API_URL=
VITE_GISTDA_API_KEY=

# 4. Google Maps Platform (กรณีต้องการใช้แผนที่ Google Maps แท้ๆ แทน OpenStreetMap)
# ขอรับได้ที่: https://console.cloud.google.com/ (Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=
